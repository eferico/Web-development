# Copy to .env and fill in. Never commit .env.
PORT=3000

# Paystack keys: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Long random string protecting /api/admin/* (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_TOKEN=change-me

# Where the SQLite file lives (back this file up!)
DB_PATH=./data/jamena.db

# Set to 1 only if running behind a reverse proxy (nginx, Render, Railway, etc.)
TRUST_PROXY=0
